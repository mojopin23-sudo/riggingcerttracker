# Copy to .env for local use. On Fly, set APP_PASSWORD and AUTH_SECRET with
# `fly secrets set` instead of committing them.
#
#   openssl rand -base64 24    # APP_PASSWORD
#   openssl rand -base64 48    # AUTH_SECRET

# Shared login. One account for the terminal.
APP_USER=terminal
APP_PASSWORD=choose-a-long-password

# Signs the session cookie. Use a long random string.
AUTH_SECRET=replace-with-a-long-random-string

# Where the SQLite database and uploaded certificates are stored.
# Mount a persistent disk here in production.
DATA_DIR=./data

# Port used by `npm start` is 43123 in the package scripts.
# Docker uses PORT inside the container.
PORT=43123
